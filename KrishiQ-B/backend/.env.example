# ==============================================================================
# KrishiQ Backend Environment Configuration
# Problem Statement: SIH26032
# ==============================================================================

# Server Environment
PORT=5000
NODE_ENV=development

# Base API Prefix
API_PREFIX=/api

# CORS Allowed Origins
# Comma-separated origins allowed to make cross-origin requests
# (e.g. Vite dev server running on http://localhost:5173)
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# Supabase Configuration (Phase 2 & Phase 3)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

